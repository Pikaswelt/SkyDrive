{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyDrive",
  "version": "1.0.0",
  "identifier": "com.skydrive.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:43123",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SkyDrive",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 740,
        "center": true,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
